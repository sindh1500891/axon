# Axon test sandbox
BASE_URL=https://axon--test.sandbox.my.salesforce.com
SF_SANDBOX_URL=https://test.salesforce.com

# --- Auth mode ---
# ui  = username/password UI login (may require MFA, see REUSE_SESSION below)
# jwt = JWT Bearer Flow — no MFA, requires a Connected App configured for digital signatures
# See the "JWT BEARER FLOW" section at the bottom of this file when using jwt.
AUTH_MODE=ui

# ============================================================
# UI LOGIN — used only when AUTH_MODE=ui
# ============================================================

# Credentials (never commit .env)
SF_USERNAME=your.username@axon.com.test

# Encrypted password: npm run encrypt:password -- "your-password"
SF_PASSWORD_ENCRYPTED=

# Secret used to encrypt/decrypt values above (keep private)
ENCRYPTION_SECRET=axon-bdd-default-secret

# Run browser visibly (required for manual verification code)
HEADED=true

# Keep Chrome open after the test ends (headed mode only)
KEEP_BROWSER_OPEN=true

# false = fresh login each test run (requires MFA)
# true  = reuse saved session — skips login and MFA entirely
REUSE_SESSION=false

# One-time manual capture: npm run session:save
# Log in in the browser, complete MFA, press Enter in terminal to save cookies.

# Wait for manual verification code on login (ignored when REUSE_SESSION=true)
ALWAYS_PROMPT_VERIFICATION=true
VERIFICATION_TIMEOUT_MS=180000

# Local session file (cookies, localStorage, indexedDB — not the verification code itself)
SESSION_STORAGE_PATH=playwright/.auth/salesforce.json
SAVE_SESSION=true

# ============================================================
# JWT BEARER FLOW — used only when AUTH_MODE=jwt
# Requires a Connected App with digital signatures enabled.
# ============================================================

# Consumer Key of the Connected App (Setup > App Manager > your Connected App)
SF_JWT_CLIENT_ID=

# Sandbox username the JWT is issued for (must match the Salesforce username exactly)
SF_JWT_USERNAME=

# Path to the RSA private key (.pem) matching the certificate uploaded to the Connected App.
# Keep this file OUTSIDE version control — never commit it.
SF_JWT_PRIVATE_KEY_PATH=secrets/axontest-server.key

# Token audience: sandbox = https://test.salesforce.com, production = https://login.salesforce.com
SF_JWT_AUDIENCE=https://test.salesforce.com

# OAuth token endpoint host (usually the same host as the audience)
SF_JWT_LOGIN_URL=https://test.salesforce.com
